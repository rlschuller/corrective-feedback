{
  "name": "pi-corrective-feedback",
  "version": "0.1.0",
  "description": "English corrections for your Pi and Claude Code prompts, reviewed by a separate model outside the main conversation.",
  "author": "Rodrigo Schuller (https://github.com/rlschuller)",
  "license": "MIT",
  "homepage": "https://github.com/rlschuller/corrective-feedback",
  "repository": { "type": "git", "url": "git+https://github.com/rlschuller/corrective-feedback.git" },
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["index.ts", "src", "hooks", "scripts", "update-plot.sh", ".claude-plugin/plugin.json", ".claude-plugin/marketplace.json", "README.md", "docs", "config.example.json", "claude-config.example.json", "claude-keybindings.example.json"],
  "engines": { "node": ">=22.19" },
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "plot": "bash update-plot.sh",
    "claude:check": "node test/claude-check.mjs",
    "claude:typecheck": "tsc -p tsconfig.claude.json"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
